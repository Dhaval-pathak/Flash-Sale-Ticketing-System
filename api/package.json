{
  "name": "flash-sale-api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "nodemon --watch src -e ts --exec tsx src/index.ts",
    "dev:api": "npm run dev",
    "build": "tsc",
    "test": "node --experimental-strip-types --test ../tests/*.test.ts",
    "db:push": "prisma db push",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "prisma:generate": "prisma generate"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "ioredis": "^6.0.0",
    "pg": "^8.11.0",
    "prisma": "^5.18.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "nodemon": "^2.0.22"
  }
}
